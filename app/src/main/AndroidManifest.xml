<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nur für Android 9 und älter nötig: ab Android 10 übernimmt Scoped Storage das Speichern. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Für die In-App-Aktualisierung: Installation der von GitHub heruntergeladenen Update-APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.DammBoard"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.DammBoard">
            <!-- configChanges: Die Oberfläche ist komplett Compose und passt sich selbst an. Ohne
                 diese Angabe würde Android die Activity z. B. beim Anstecken einer Tastatur, beim
                 Umschalten des Bildschirmmodus oder bei Änderung der Anzeigegröße neu starten –
                 und dabei den gesamten Tafelinhalt aller Seiten verwerfen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
